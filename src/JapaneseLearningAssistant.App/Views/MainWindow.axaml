<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JapaneseLearningAssistant.App.ViewModels"
        xmlns:input="using:Avalonia.Input"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="JapaneseLearningAssistant.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="日语学习助手"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="ListBox.sentence-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.sentence-list ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#172033"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#697586"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Background="#EEF2F6">
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                    <TextBlock Text="日语学习助手" FontSize="22" FontWeight="SemiBold" Foreground="#172033"/>
                    <TextBlock Text="输入、分析、朗读和问题讲解集中在一个学习工作台" Classes="caption" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar Width="120" Height="6" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                    <Button Content="分析" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}" MinWidth="96"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnSpacing="12" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="14">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <StackPanel Spacing="10">
                        <StackPanel>
                            <TextBlock Text="输入" Classes="section-title"/>
                            <TextBlock Text="选择场景后输入中文或日语" Classes="caption" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding LanguageModes}" SelectedItem="{Binding SelectedLanguageMode}" MinHeight="34"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" MinHeight="34"/>
                        </Grid>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Text="{Binding InputText, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             input:InputMethod.IsInputMethodEnabled="True"
                             PlaceholderText="输入中文或日语..."/>

                    <Expander Grid.Row="2" Header="朗读设置" IsExpanded="False">
                        <StackPanel Spacing="8" Margin="0,8,0,0">
                            <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" MinHeight="34"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <TextBlock Text="语速" VerticalAlignment="Center"/>
                                <Slider Grid.Column="1" Minimum="0.6" Maximum="1.2" Value="{Binding SpeakingRate}" TickFrequency="0.05"/>
                                <TextBlock Grid.Column="2" Text="{Binding SpeakingRate, StringFormat={}{0:F2}}" VerticalAlignment="Center" MinWidth="38"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid RowDefinitions="Auto,Auto,*,Auto,220" RowSpacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel>
                            <TextBlock Text="分析与朗读文本" Classes="section-title"/>
                            <TextBlock Text="切换版本后，逐句列表会自动刷新" Classes="caption" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" HorizontalAlignment="Left" Width="180" MinHeight="34"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#F5F7FA" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="4" Padding="10">
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="#344054"/>
                    </Border>

                    <TextBox Grid.Row="2"
                             Text="{Binding SelectedOutputText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="150"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             IsReadOnly="True"/>

                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E1E5EC" BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding PlaybackScopes}"
                                      SelectedItem="{Binding SelectedPlaybackScope}"
                                      Height="36"
                                      Width="86"
                                      VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="‹" Command="{Binding PlayPreviousSentenceCommand}" IsEnabled="{Binding CanPlayPreviousSentence}" IsVisible="{Binding IsSentencePlaybackScope}" Width="34" MinWidth="34" Height="36" VerticalAlignment="Center" ToolTip.Tip="上一句"/>
                            <Button Grid.Column="2" Content="{Binding PrimaryPlaybackIcon}" Command="{Binding PrimaryPlaybackCommand}" IsEnabled="{Binding CanUsePrimaryPlayback}" Width="42" MinWidth="42" Height="36" VerticalAlignment="Center" ToolTip.Tip="{Binding PrimaryPlaybackButtonText}"/>
                            <Button Grid.Column="3" Content="›" Command="{Binding PlayNextSentenceCommand}" IsEnabled="{Binding CanPlayNextSentence}" IsVisible="{Binding IsSentencePlaybackScope}" Width="34" MinWidth="34" Height="36" VerticalAlignment="Center" ToolTip.Tip="下一句"/>
                            <Button Grid.Column="4" Content="■" Command="{Binding StopAudioCommand}" IsEnabled="{Binding HasLoadedAudio}" Width="34" MinWidth="34" Height="36" VerticalAlignment="Center" ToolTip.Tip="停止"/>
                            <Slider Grid.Column="5"
                                    Minimum="0"
                                    Maximum="{Binding PlaybackDurationSeconds}"
                                    Value="{Binding PlaybackPositionSeconds}"
                                    IsEnabled="{Binding HasLoadedAudio}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{Binding PlaybackTimeText}" VerticalAlignment="Center" MinWidth="82"/>
                            <ComboBox Grid.Column="7"
                                      ItemsSource="{Binding WholeAudioPlaybackModes}"
                                      SelectedItem="{Binding SelectedWholeAudioPlaybackMode}"
                                      IsVisible="{Binding IsWholePlaybackScope}"
                                      Height="36"
                                      Width="150"
                                      VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="7"
                                      ItemsSource="{Binding SentencePlaybackModes}"
                                      SelectedItem="{Binding SelectedSentencePlaybackMode}"
                                      IsVisible="{Binding IsSentencePlaybackScope}"
                                      Height="36"
                                      Width="150"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#FFFFFF" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,8,0,0" IsVisible="{Binding !IsCompactLayout}">
                        <ListBox x:Name="SentenceListBox"
                                 Classes="sentence-list"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding SentenceAudioItems}"
                                 SelectedItem="{Binding SelectedSentenceAudioItem}"
                                 DoubleTapped="SentenceListBox_DoubleTapped">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:SentenceAudioItemViewModel">
                                    <Border Background="{Binding CurrentBackground}"
                                            BorderBrush="{Binding CurrentBorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            CornerRadius="4"
                                            Padding="10,8"
                                            Margin="0,1">
                                        <Grid ColumnDefinitions="4,32,*,Auto" ColumnSpacing="10">
                                            <Border Background="{Binding CurrentAccentBackground}" CornerRadius="2"/>
                                            <Border Grid.Column="1" Background="{Binding CurrentIndexBackground}" CornerRadius="10" MinWidth="28" Height="22" HorizontalAlignment="Left">
                                                <TextBlock Text="{Binding IndexText}" Foreground="{Binding CurrentIndexForeground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding CurrentTextForeground}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AudioStatusText}" Foreground="{Binding AudioStatusForeground}" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>

                    <TabControl Grid.Row="4" IsVisible="{Binding IsCompactLayout}" FontSize="14">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="逐句" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <Border Background="#FFFFFF" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <ListBox x:Name="CompactSentenceListBox"
                                         Classes="sentence-list"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemsSource="{Binding SentenceAudioItems}"
                                         SelectedItem="{Binding SelectedSentenceAudioItem}"
                                         DoubleTapped="SentenceListBox_DoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SentenceAudioItemViewModel">
                                            <Border Background="{Binding CurrentBackground}"
                                                    BorderBrush="{Binding CurrentBorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    CornerRadius="4"
                                                    Padding="10,8"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="4,32,*,Auto" ColumnSpacing="10">
                                                    <Border Background="{Binding CurrentAccentBackground}" CornerRadius="2"/>
                                                    <Border Grid.Column="1" Background="{Binding CurrentIndexBackground}" CornerRadius="10" MinWidth="28" Height="22" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding IndexText}" Foreground="{Binding CurrentIndexForeground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding CurrentTextForeground}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding AudioStatusText}" Foreground="{Binding AudioStatusForeground}" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="问题" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <Border Background="#FFFFFF" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <ListBox ItemsSource="{Binding Issues}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:IssueViewModel">
                                            <Border BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,10">
                                                <StackPanel Spacing="5">
                                                    <TextBlock Text="{Binding TypeDisplay}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Original}" TextWrapping="Wrap" Foreground="#8A3B12"/>
                                                    <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Foreground="#116149"/>
                                                    <TextBlock Text="{Binding ExplanationZh}" TextWrapping="Wrap" Foreground="#344054"/>
                                                    <TextBlock Text="{Binding JlptLevel}" Foreground="#697586"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="历史" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <Border Background="#FFFFFF" BorderBrush="#E1E5EC" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <ListBox ItemsSource="{Binding HistoryItems}"
                                         SelectedItem="{Binding SelectedHistoryItem}"
                                         DoubleTapped="HistoryListBox_DoubleTapped">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                            <Border BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,8">
                                                <StackPanel Spacing="4">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding TimeText}" Foreground="#697586" FontSize="12"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding IssueCountText}" Foreground="#697586" FontSize="12"/>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Summary}" Foreground="#5F6B7A" TextWrapping="Wrap" MaxHeight="42"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="1" CornerRadius="6" Padding="16" IsVisible="{Binding !IsCompactLayout}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel>
                        <TextBlock Text="侧边栏" Classes="section-title"/>
                        <TextBlock Text="问题讲解和最近历史" Classes="caption" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" FontSize="14">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="问题" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <ListBox ItemsSource="{Binding Issues}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:IssueViewModel">
                                        <Border BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,10">
                                            <StackPanel Spacing="5">
                                                <TextBlock Text="{Binding TypeDisplay}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Original}" TextWrapping="Wrap" Foreground="#8A3B12"/>
                                                <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Foreground="#116149"/>
                                                <TextBlock Text="{Binding ExplanationZh}" TextWrapping="Wrap" Foreground="#344054"/>
                                                <TextBlock Text="{Binding JlptLevel}" Foreground="#697586"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="历史" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <ListBox ItemsSource="{Binding HistoryItems}"
                                     SelectedItem="{Binding SelectedHistoryItem}"
                                     DoubleTapped="HistoryListBox_DoubleTapped">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HistoryItemViewModel">
                                        <Border BorderBrush="#E1E5EC" BorderThickness="0,0,0,1" Padding="0,8">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding TimeText}" Foreground="#697586" FontSize="12"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding IssueCountText}" Foreground="#697586" FontSize="12"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Summary}" Foreground="#5F6B7A" TextWrapping="Wrap" MaxHeight="42"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D9DEE7" BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock Text="{Binding StatusText}" Foreground="#344054" TextWrapping="Wrap"/>
        </Border>
    </Grid>

</Window>
