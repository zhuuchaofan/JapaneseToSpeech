<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:JapaneseLearningAssistant.App.ViewModels"
        xmlns:input="using:Avalonia.Input"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        x:Class="JapaneseLearningAssistant.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="日语学习助手"
        Width="1280"
        Height="820"
        MinWidth="1040"
        MinHeight="680">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <!-- ======================== Shared Resources ======================== -->
    <Window.Resources>
        <!-- Color palette -->
        <SolidColorBrush x:Key="PageBackground" Color="#EEF2F6"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorder" Color="#D9DEE7"/>
        <SolidColorBrush x:Key="SectionBorder" Color="#E1E5EC"/>
        <SolidColorBrush x:Key="SummaryBackground" Color="#F5F7FA"/>
        <SolidColorBrush x:Key="PlayerBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#172033"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#344054"/>
        <SolidColorBrush x:Key="TextMuted" Color="#697586"/>
        <SolidColorBrush x:Key="TextHistorySummary" Color="#5F6B7A"/>
        <SolidColorBrush x:Key="IssueOriginal" Color="#8A3B12"/>
        <SolidColorBrush x:Key="IssueSuggestion" Color="#116149"/>

        <!-- Shared DataTemplates -->
        <DataTemplate x:Key="SentenceItemTemplate" x:DataType="vm:SentenceAudioItemViewModel">
            <Border Background="{Binding CurrentBackground}"
                    BorderBrush="{Binding CurrentBorderBrush}"
                    BorderThickness="0,0,0,1"
                    CornerRadius="4"
                    Padding="10,8"
                    Margin="0,1">
                <Grid ColumnDefinitions="4,32,*,Auto" ColumnSpacing="10">
                    <Border Background="{Binding CurrentAccentBackground}" CornerRadius="2"/>
                    <Border Grid.Column="1" Background="{Binding CurrentIndexBackground}" CornerRadius="10" MinWidth="28" Height="22" HorizontalAlignment="Left">
                        <TextBlock Text="{Binding IndexText}" Foreground="{Binding CurrentIndexForeground}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" Foreground="{Binding CurrentTextForeground}"/>
                    <TextBlock Grid.Column="3" Text="{Binding AudioStatusText}" Foreground="{Binding AudioStatusForeground}" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="IssueItemTemplate" x:DataType="vm:IssueViewModel">
            <Border BorderBrush="{StaticResource SectionBorder}" BorderThickness="0,0,0,1" Padding="0,10">
                <StackPanel Spacing="5">
                    <TextBlock Text="{Binding TypeDisplay}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Original}" TextWrapping="Wrap" Foreground="{StaticResource IssueOriginal}"/>
                    <TextBlock Text="{Binding Suggestion}" TextWrapping="Wrap" Foreground="{StaticResource IssueSuggestion}"/>
                    <TextBlock Text="{Binding ExplanationZh}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                    <TextBlock Text="{Binding JlptLevel}" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="HistoryItemTemplate" x:DataType="vm:HistoryItemViewModel">
            <Border BorderBrush="{StaticResource SectionBorder}" BorderThickness="0,0,0,1" Padding="0,8">
                <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="{Binding IssueCountText}" Foreground="{StaticResource TextMuted}" FontSize="12"/>
                    </Grid>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextHistorySummary}" TextWrapping="Wrap" MaxHeight="42"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <!-- ======================== Shared Styles ======================== -->
    <Window.Styles>
        <Style Selector="ListBox.sentence-list ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.sentence-list ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.icon-button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Expander.settings-expander">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </Window.Styles>

    <!-- ======================== Main Layout ======================== -->
    <Grid RowDefinitions="Auto,*,Auto" Background="{StaticResource PageBackground}">

        <!-- Header bar -->
        <Border Grid.Row="0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel>
                    <TextBlock Text="日语学习助手" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="输入、分析、朗读和问题讲解集中在一个学习工作台" Classes="caption" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <ProgressBar Width="120" Height="6" IsIndeterminate="True" IsVisible="{Binding IsBusy}"/>
                    <Button Content="分析" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsBusy}" MinWidth="96"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content: 3-column layout -->
        <Grid x:Name="MainContentGrid" Grid.Row="1" ColumnSpacing="12" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== Left column: Input & Settings ==================== -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="12">
                        <StackPanel>
                            <TextBlock Text="输入" Classes="section-title"/>
                            <TextBlock Text="选择场景后输入中文或日语" Classes="caption" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <ComboBox ItemsSource="{Binding LanguageModes}" SelectedItem="{Binding SelectedLanguageMode}" MinHeight="34" HorizontalAlignment="Stretch"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Scenarios}" SelectedItem="{Binding SelectedScenario}" MinHeight="34" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ComboBox ItemsSource="{Binding PromptProfiles}" SelectedItem="{Binding SelectedPromptProfile}" HorizontalAlignment="Stretch" MinHeight="34" ToolTip.Tip="{Binding SelectedPromptProfile.Description}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBox Text="{Binding InputText, UpdateSourceTrigger=LostFocus}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="160"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             input:InputMethod.IsInputMethodEnabled="True"
                             PlaceholderText="输入中文或日语..."/>

                    <StackPanel Spacing="8" HorizontalAlignment="Stretch">
                        <Expander Header="AI 设置" IsExpanded="False" Classes="settings-expander">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <TextBlock Text="分析供应商" Classes="caption"/>
                                <ComboBox ItemsSource="{Binding AnalysisSettings.AnalysisProviders}" SelectedItem="{Binding AnalysisSettings.SelectedProvider}" MinHeight="34" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="模型" Classes="caption"/>
                                <TextBox Text="{Binding AnalysisSettings.Model}" MinHeight="34" HorizontalAlignment="Stretch"/>
                                <TextBlock Text="API Key" Classes="caption"/>
                                <TextBox Text="{Binding AnalysisSettings.ApiKey}" PasswordChar="*" MinHeight="34" HorizontalAlignment="Stretch" PlaceholderText="保存后写入本地配置"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,4,0,0">
                                    <Button Content="测试连接" Command="{Binding AnalysisSettings.TestConnectionCommand}" IsEnabled="{Binding !IsBusy}" MinHeight="34"/>
                                    <Button Grid.Column="1" Content="保存设置" Command="{Binding AnalysisSettings.SaveSettingsCommand}" IsEnabled="{Binding !IsBusy}" MinHeight="34"/>
                                </Grid>
                            </StackPanel>
                        </Expander>

                        <Expander Header="朗读设置" IsExpanded="False" Classes="settings-expander">
                            <StackPanel Spacing="8" Margin="0,8,0,0">
                                <ComboBox ItemsSource="{Binding Voices}" SelectedItem="{Binding SelectedVoice}" MinHeight="34" HorizontalAlignment="Stretch"/>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="语速" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Minimum="0.6" Maximum="1.2" Value="{Binding SpeakingRate}" TickFrequency="0.05"/>
                                    <TextBlock Grid.Column="2" Text="{Binding SpeakingRate, StringFormat={}{0:F2}}" VerticalAlignment="Center" MinWidth="38"/>
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ==================== Center column: Analysis & Playback ==================== -->
            <Border Grid.Column="1" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16">
                <Grid RowDefinitions="Auto,Auto,1.1*,Auto,0.9*" RowSpacing="12">
                    <!-- Section header + style selector -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel>
                            <TextBlock Text="分析与朗读文本" Classes="section-title"/>
                            <TextBlock Text="切换版本后，逐句列表会自动刷新" Classes="caption" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Styles}" SelectedItem="{Binding SelectedStyle}" HorizontalAlignment="Left" Width="180" MinHeight="34"/>
                    </Grid>

                    <!-- Summary -->
                    <Border Grid.Row="1" Background="{StaticResource SummaryBackground}" BorderBrush="{StaticResource SectionBorder}" BorderThickness="1" CornerRadius="4" Padding="10">
                        <TextBlock Text="{Binding SummaryText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}"/>
                    </Border>

                    <!-- Output text -->
                    <TextBox Grid.Row="2"
                             Text="{Binding SelectedOutputText}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="150"
                             VerticalAlignment="Stretch"
                             VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             IsReadOnly="True"/>

                    <!-- Playback controls -->
                    <Border Grid.Row="3" Background="{StaticResource PlayerBackground}" BorderBrush="{StaticResource SectionBorder}" BorderThickness="1" CornerRadius="4" Padding="8">
                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                            <ComboBox ItemsSource="{Binding PlaybackScopes}"
                                      SelectedItem="{Binding SelectedPlaybackScope}"
                                      Height="36"
                                      Width="86"
                                      VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Command="{Binding SentencePlayback.PlayPreviousCommand}" IsEnabled="{Binding CanPlayPreviousSentence}" IsVisible="{Binding IsSentencePlaybackScope}" Classes="icon-button" ToolTip.Tip="上一句">
                                <TextBlock Text="‹" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding PrimaryPlaybackCommand}" IsEnabled="{Binding CanUsePrimaryPlayback}" Width="42" MinWidth="42" Height="36" Padding="0" VerticalAlignment="Center" ToolTip.Tip="{Binding PrimaryPlaybackButtonText}">
                                <TextBlock Text="{Binding PrimaryPlaybackIcon}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="3" Command="{Binding SentencePlayback.PlayNextCommand}" IsEnabled="{Binding CanPlayNextSentence}" IsVisible="{Binding IsSentencePlaybackScope}" Classes="icon-button" ToolTip.Tip="下一句">
                                <TextBlock Text="›" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button Grid.Column="4" Command="{Binding StopAudioCommand}" IsEnabled="{Binding Playback.HasLoadedAudio}" Classes="icon-button" ToolTip.Tip="停止">
                                <TextBlock Text="■" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Slider Grid.Column="5"
                                    Minimum="0"
                                    Maximum="{Binding Playback.DurationSeconds}"
                                    Value="{Binding Playback.PositionSeconds}"
                                    IsEnabled="{Binding Playback.HasLoadedAudio}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="{Binding Playback.TimeText}" VerticalAlignment="Center" MinWidth="82"/>
                            <ComboBox Grid.Column="7"
                                      ItemsSource="{Binding WholeAudioPlaybackModes}"
                                      SelectedItem="{Binding SelectedWholeAudioPlaybackMode}"
                                      IsVisible="{Binding IsWholePlaybackScope}"
                                      Height="36"
                                      Width="150"
                                      VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="7"
                                      ItemsSource="{Binding SentencePlayback.PlaybackModes}"
                                      SelectedItem="{Binding SentencePlayback.PlaybackMode}"
                                      IsVisible="{Binding IsSentencePlaybackScope}"
                                      Height="36"
                                      Width="150"
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Sentence list (normal layout) -->
                    <Border Grid.Row="4" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource SectionBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0" MinHeight="130" IsVisible="{Binding !IsCompactLayout}">
                        <ListBox x:Name="SentenceListBox"
                                 Classes="sentence-list"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemsSource="{Binding SentencePlayback.Items}"
                                 SelectedItem="{Binding SentencePlayback.SelectedSentence}"
                                 ItemTemplate="{StaticResource SentenceItemTemplate}"
                                 DoubleTapped="SentenceListBox_DoubleTapped"/>
                    </Border>

                    <!-- Compact layout: tabbed sentence/issues/history -->
                    <TabControl Grid.Row="4" IsVisible="{Binding IsCompactLayout}" FontSize="14">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="逐句" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource SectionBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <ListBox x:Name="CompactSentenceListBox"
                                         Classes="sentence-list"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemsSource="{Binding SentencePlayback.Items}"
                                         SelectedItem="{Binding SentencePlayback.SelectedSentence}"
                                         ItemTemplate="{StaticResource SentenceItemTemplate}"
                                         DoubleTapped="SentenceListBox_DoubleTapped"/>
                            </Border>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="问题" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource SectionBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <ListBox ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueItemTemplate}"/>
                            </Border>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="历史" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource SectionBorder}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <ListBox ItemsSource="{Binding HistoryItems}"
                                         SelectedItem="{Binding SelectedHistoryItem}"
                                         ItemTemplate="{StaticResource HistoryItemTemplate}"
                                         DoubleTapped="HistoryListBox_DoubleTapped"/>
                            </Border>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>

            <!-- ==================== Right column: Sidebar (issues + history) ==================== -->
            <Border Grid.Column="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="16" IsVisible="{Binding !IsCompactLayout}">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <StackPanel>
                        <TextBlock Text="侧边栏" Classes="section-title"/>
                        <TextBlock Text="问题讲解和最近历史" Classes="caption" Margin="0,2,0,0"/>
                    </StackPanel>
                    <TabControl Grid.Row="1" FontSize="14">
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="问题" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <ListBox ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource IssueItemTemplate}"/>
                        </TabItem>
                        <TabItem>
                            <TabItem.Header>
                                <TextBlock Text="历史" FontSize="14" FontWeight="SemiBold"/>
                            </TabItem.Header>
                            <ListBox ItemsSource="{Binding HistoryItems}"
                                     SelectedItem="{Binding SelectedHistoryItem}"
                                     ItemTemplate="{StaticResource HistoryItemTemplate}"
                                     DoubleTapped="HistoryListBox_DoubleTapped"/>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
        </Border>
    </Grid>

</Window>
